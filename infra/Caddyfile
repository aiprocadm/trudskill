{$PUBLIC_DOMAIN} {
	encode zstd gzip

	@api path /api/v1/*
	handle @api {
		# НЕСКОЛЬКО ЭКЗЕМПЛЯРОВ БЭКЕНДА (§12.1, 2026-08-09).
		#
		# Замер показал: под нагрузкой в 50 сессий бэкенд занимает 94% ОДНОГО ядра при
		# восьми на машине. Node обрабатывает запросы по очереди в одном потоке, поэтому
		# упирались не в базу и не в код, а в единственный процесс.
		#
		# `dynamic a` заставляет Caddy КАЖДЫЙ РАЗ спрашивать у docker, сколько сейчас
		# экземпляров: со статическим `reverse_proxy backend:3001` адрес разрешается один
		# раз при старте, и добавленные позже копии просто не получают запросов.
		#
		# Число экземпляров задаётся при запуске:
		#   docker compose -f infra/docker-compose.prod.yml up -d --scale backend=4
		reverse_proxy {
			dynamic a {
				name backend
				port 3001
				refresh 10s
			}
			lb_policy least_conn
			# Экземпляр, который не отвечает, выводится из ротации на полминуты, а не
			# получает запросы снова и снова.
			health_uri /api/v1/health/live
			health_interval 10s
			health_timeout 3s
		}
	}

	@ws path /ws*
	handle @ws {
		reverse_proxy realtime:3002
	}

	handle {
		reverse_proxy frontend:3000
	}
}
