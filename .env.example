NODE_ENV=development
RELEASE_VERSION=dev-local

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cdoprof
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=cdoprof-dev

# Antivirus scan gate (V1.1). When false, NoopAntivirusScanner marks files clean (dev/pilot).
# Flip to true ONLY when a clamd instance is reachable at CLAMAV_HOST:CLAMAV_PORT (spec §9).
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Gotenberg (ФТ-A1.3): сервис DOCX→PDF. Контейнер `gotenberg` есть в docker-compose.
# В Фазе 0 только инфраструктура; движок рендера подключается в Фазе 1.
GOTENBERG_URL=http://gotenberg:3000

# Email notifications (Phase 5, включены по-настоящему в Фазе 0 Task 4 дельта-ТЗ).
# When false, NoopMailer records deliveries as skipped (dev/pilot) и dev-режим печатает
# ссылки (magic-link, pre-exam) в лог. Flip to true ONLY when SMTP_* point at a reachable
# mail server (cross-field валидация env: true требует SMTP_HOST; USER/PASSWORD — парой).
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cdoprof.local
# Ночные напоминания (переобучение 90/30/7, дедлайны курсов, истечение лицензий).
# Без этого флага письма-напоминания не сканируются даже при включённой почте.
RECERTIFICATION_SCAN_ENABLED=false

AUTH_JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
AUTH_PROVIDER=legacy
SUPERTOKENS_CORE_URI=http://127.0.0.1:3567
SUPERTOKENS_API_KEY=change-me-supertokens-api-key
SUPERTOKENS_APP_NAME=cdoprof
SUPERTOKENS_API_DOMAIN=http://localhost:3001
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

FRONTEND_PORT=3000
BACKEND_PORT=3001
REALTIME_PORT=3002

BACKEND_PUBLIC_URL=http://localhost:3001
REALTIME_PUBLIC_URL=http://localhost:3002
WORKER_INTERNAL_URL=http://localhost:3010

# Должен совпадать с API_PREFIX бэкенда (по умолчанию /api/v1), иначе фронт бьёт не в те маршруты
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3002

WORKER_CONCURRENCY=5
DOCUMENT_GENERATION_QUEUE=documents.generation
DOCUMENTS_STORAGE_BUCKET=cdoprof-dev
REALTIME_PUBLISH_KEY=change-me-realtime-key
REALTIME_STREAM_MAXLEN=5000
REALTIME_STREAM_TTL_SECONDS=86400
REALTIME_STREAM_READ_BATCH=200
REALTIME_DIAGNOSTICS_MAX_ITEMS=1000
REALTIME_DIAGNOSTICS_TTL_SECONDS=604800
# Обязателен при NODE_ENV=production (проверка подписи вебхуков интеграций)
INTEGRATION_WEBHOOK_SECRET=dev-webhook-secret-min-10
DB_MIGRATIONS_ENABLED=true
DB_MIGRATIONS_DIR=migrations

# Токен на ручку метрик `/api/v1/metrics` (Фаза 6 Task 5).
# Обязателен при NODE_ENV=production: без него бэкенд не стартует, иначе наружу торчат
# пути, коды ответов и объёмы запросов. Минимум 16 символов.
# Тот же токен читает скрипт тревог `infra/ops-alerts.sh`.
METRICS_TOKEN=dev-metrics-token-change-me

# Служебная ручка воркера (/healthz, /metrics). Наружу не публикуется.
WORKER_HEALTH_PORT=3030
# Молчание воркера дольше этого срока считается зависанием (мс).
WORKER_STALL_THRESHOLD_MS=300000

# Сроки хранения (Фаза 6 Task 9). Раньше эти таблицы не чистились вообще.
# Отозванные и просроченные сессии хранятся ещё столько дней — на случай разбора
# инцидента «кто и когда вошёл».
SESSION_RETENTION_DAYS=30
# Использованные и протухшие ссылки входа: это прямые ПДн (почта, IP), долго не нужны.
MAGIC_LINK_RETENTION_DAYS=7
# Отметки «сообщение уже обработано». ОСТОРОЖНО: срок должен быть заведомо больше окна
# повторов, иначе старое сообщение обработается второй раз и выпустится второй документ.
PROCESSED_MESSAGE_RETENTION_DAYS=14
# Журнал аудита: 0 = хранить вечно (значение по умолчанию). Ставить срок — решение
# владельца: журнал нужен для проверок и разбирательств.
AUDIT_RETENTION_DAYS=0
RETENTION_SWEEP_ENABLED=true
