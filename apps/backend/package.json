{
  "name": "@trudskill/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "seed:staging": "tsx scripts/seed-staging.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "pnpm --filter @trudskill/shared-types build && pnpm --filter @trudskill/api-contracts build && pnpm --filter @trudskill/docx-render build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "ops:neutralize-known-passwords": "tsx scripts/neutralize-known-passwords.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@trudskill/api-contracts": "workspace:*",
    "@trudskill/docx-render": "workspace:*",
    "adm-zip": "^0.5.17",
    "amqplib": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.8.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "redis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4"
  }
}
